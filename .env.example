# Pillapago - Variables de entorno para desarrollo local
# Este archivo NO debe contener credenciales reales.
# Copiar a .env y ajustar según sea necesario.

# PostgreSQL
POSTGRES_DB=pillapago
POSTGRES_USER=pillapago_user
POSTGRES_PASSWORD=pillapago_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=redis_user
REDIS_PASSWORD=redis_pass

# Aplicación Spring Boot
APP_NAME=pillapago-api
APP_PORT=8080
JAVA_OPTS=-Xms256m -Xmx300m -XX:+UseSerialGC

# Flyway
FLYAYER_locations=classpath:db/migration
FLYWAY_user=${POSTGRES_USER}
FLYWAY_password=${POSTGRES_PASSWORD}

# Actuator
MANAGEMENT_ENDPOINT_HEALTH_SHOW_ALWAYS=true
MANAGEMENT_ENDPOINTS_WEB_BASE_PATH=/actuator